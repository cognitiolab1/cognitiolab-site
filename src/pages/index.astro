---
import Base from '../layouts/Base.astro';

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "CognitioLab",
  "url": "https://thecognitiolab.com",
  "description": "A studio building focused Shopify apps that solve real merchant problems.",
  "sameAs": ["https://x.com/cognitiolab", "https://www.linkedin.com/company/cognitiolabs"],
};

const heroApps = [
  {
    name: 'PayShift',
    icon: '/assets/payshift/payshift-avatar.png',
    caption: 'Hide, rename and reorder payment and shipping methods.',
    href: '/products/payshift',
  },
  {
    name: 'ChargeIt',
    icon: 'https://cdn.shopify.com/app-store/listing_images/bf644a28103312af9fdee59bc1167edd/icon/CLLC4OGH5JYDEAE=.png',
    caption: 'Add a COD fee or reward prepaid orders with a discount.',
    href: '/products/chargeit',
  },
  {
    name: 'GateKeeper',
    icon: 'https://cdn.shopify.com/app-store/listing_images/dceae45ce42d4e6822a099d84a3d5eb1/icon/CKn41N-E-5UDEAE=.png',
    caption: 'Hide prices until login and lock products or pages.',
    href: '/products/gatekeeper',
  },
  {
    name: 'Routify',
    icon: '/assets/routify/routify-logo.png',
    caption: 'Find 404 errors and fix redirects in bulk.',
    href: '/products/routify',
  },
];
---
<Base navCta={{ label: 'Browse apps', href: '#apps' }}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(orgSchema)} />

  <header class="home-hero" id="home-hero">
    <div class="wrap home-hero-grid">
      <div>
        <p class="home-kicker">Shopify apps by CognitioLab</p>
        <h1 class="home-title">Small Shopify apps that fix real store problems.</h1>
        <p class="home-lead">Control your checkout, charge for cash on delivery, hide prices from the public and fix broken links. No code needed.</p>
        <div class="hero-cta">
          <a href="#apps" class="btn btn-primary">See the apps</a>
          <span class="home-rating"><b>★ 5.0</b> across 7 reviews of our apps</span>
        </div>
      </div>

      <div class="hero-showcase" id="hero-showcase">
        <div class="hero-tabs" role="tablist" aria-label="CognitioLab apps">
          {heroApps.map((app, i) => (
            <button type="button" class:list={['hero-tab', { active: i === 0 }]} role="tab" id={`hero-tab-${i}`} aria-controls={`hero-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'}>
              <img src={app.icon} alt="" width="22" height="22" />
              {app.name}
            </button>
          ))}
        </div>

        <div class="hero-panels">
          {heroApps.map((app, i) => (
            <div class:list={['hero-panel', { active: i === 0 }]} role="tabpanel" id={`hero-panel-${i}`} aria-labelledby={`hero-tab-${i}`}>
                {i === 0 && (
                  <div class="co-mock" role="img" aria-label="Example checkout: a renamed payment method, a reordered list, and Cash on Delivery hidden on a high-value order">
                    <div class="co-head"><span>Payment</span><span class="co-total">Order total $640.00</span></div>
                    <div class="co-row on">
                      <span class="co-radio"></span>
                      <div><b>JazzCash</b><small>Renamed from “Online Payment Options”</small></div>
                    </div>
                    <div class="co-row">
                      <span class="co-radio"></span>
                      <div><b>Credit card</b><small>Moved up the list</small></div>
                    </div>
                    <div class="co-row off">
                      <span class="co-radio"></span>
                      <div><b>Cash on Delivery</b><small>Hidden on orders over $500</small></div>
                      <span class="co-pill">Hidden</span>
                    </div>
                  </div>
                )}

                {i === 1 && (
                  <div class="co-mock" role="img" aria-label="Example cart: a 5% discount for paying by card and a 3% fee for cash on delivery">
                    <div class="co-head"><span>How would you like to pay?</span><span class="co-total">Cart $640.00</span></div>
                    <div class="co-row on">
                      <span class="co-radio"></span>
                      <div><b>Credit card</b><small>Prepaid discount, 5%</small></div>
                      <span class="co-amt">−$32.00</span>
                    </div>
                    <div class="co-row">
                      <span class="co-radio"></span>
                      <div><b>Cash on Delivery</b><small>COD handling fee, 3%</small></div>
                      <span class="co-amt fee">+$19.20</span>
                    </div>
                    <div class="co-sum"><span>Total with card</span><b>$608.00</b></div>
                  </div>
                )}

                {i === 2 && (
                  <div class="co-mock" role="img" aria-label="Example product: visitors are asked to log in for the price, while approved wholesale customers see it">
                    <div class="co-head"><span>Classic Leather Bag</span><span class="co-total">Wholesale collection</span></div>
                    <div class="co-row off-soft">
                      <div><b>Visitor</b><small>Price and Add to Cart hidden</small></div>
                      <span class="co-pill">Log in to see price</span>
                    </div>
                    <div class="co-row on">
                      <div><b>Customer tagged “wholesale”</b><small>Price and Add to Cart shown</small></div>
                      <span class="co-amt">$48.00</span>
                    </div>
                    <div class="co-row">
                      <div><b>Passcode or secret link</b><small>Unlocks access for chosen buyers</small></div>
                    </div>
                  </div>
                )}

                {i === 3 && (
                  <div class="co-mock" role="img" aria-label="Example 404 log: broken links redirected to the right pages">
                    <div class="co-head"><span>404 log</span><span class="co-total">Example</span></div>
                    <div class="co-row">
                      <div><b>/collections/summer-sale</b><small>301 to /collections/sale</small></div>
                      <span class="co-pill good">Fixed</span>
                    </div>
                    <div class="co-row">
                      <div><b>/products/blue-shirt-old</b><small>301 to /products/blue-shirt</small></div>
                      <span class="co-pill good">Fixed</span>
                    </div>
                    <div class="co-row">
                      <div><b>/pages/about-us-2</b><small>No redirect yet</small></div>
                      <span class="co-pill">404</span>
                    </div>
                  </div>
                )}

                <p class="hero-caption">{app.caption} <a href={app.href} class="text-link">See {app.name} →</a></p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </header>

  <script is:inline>
    (function () {
      const hero = document.getElementById('hero-showcase');
      const tabs = Array.from(hero.querySelectorAll('.hero-tab'));
      const panels = Array.from(hero.querySelectorAll('.hero-panel'));
      const DELAY = 7000;
      const RESUME_AFTER_CLICK = 15000;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let current = 0;
      let timer = null;
      let resume = null;
      let held = false;

      function show(i) {
        if (i === current) return;
        const leaving = panels[current];
        current = i;
        tabs.forEach(function (tab, n) {
          tab.classList.toggle('active', n === i);
          tab.setAttribute('aria-selected', n === i ? 'true' : 'false');
        });
        panels.forEach(function (panel, n) {
          panel.classList.toggle('active', n === i);
        });
        leaving.classList.add('leaving');
        setTimeout(function () { leaving.classList.remove('leaving'); }, 500);
      }
      function stop() {
        clearInterval(timer);
        timer = null;
      }
      function start() {
        if (timer || held || resume || reduced) return;
        timer = setInterval(function () { show((current + 1) % tabs.length); }, DELAY);
      }
      function hold() {
        held = true;
        stop();
      }
      function release() {
        held = false;
        start();
      }

      tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () {
          stop();
          show(i);
          clearTimeout(resume);
          resume = setTimeout(function () {
            resume = null;
            start();
          }, RESUME_AFTER_CLICK);
        });
      });
      hero.addEventListener('mouseenter', hold);
      hero.addEventListener('mouseleave', release);
      hero.addEventListener('focusin', function (e) {
        if (e.target.matches(':focus-visible')) hold();
      });
      hero.addEventListener('focusout', release);

      start();
    })();
  </script>

  <div class="proof">
    <div class="wrap proof-inner">
      <div class="proof-quote">
        <div class="stars">★★★★★</div>
        <div>
          <div class="q">"Life saver."</div>
          <div class="who">SH Collection · Pakistan · Shopify App Store</div>
        </div>
      </div>
      <div class="proof-facts">
        <div class="proof-fact"><strong>4</strong><span>apps live, more coming</span></div>
        <div class="proof-fact"><strong>Free</strong><span>to install &amp; try</span></div>
        <div class="proof-fact"><strong>Minutes</strong><span>typical support reply</span></div>
      </div>
    </div>
  </div>

  <section class="block" id="apps">
    <div class="wrap">
      <div class="head-row">
        <div>
          <h2>Our apps</h2>
          <p>Live on the Shopify App Store, free to install.</p>
        </div>
      </div>

      <div class="apps-live">
        <div class="app">
          <div class="app-top">
            <div class="app-ico"><img src="/assets/routify/routify-logo.png" alt="Routify" width="52" height="52" /></div>
            <span class="tag tag-live">Live</span>
          </div>
          <h3>Routify</h3>
          <p>Manage 301 &amp; 404 redirects so you never lose SEO value or leave a customer stranded on a dead page.</p>
          <div class="app-foot">
            <span class="app-price">$0.00 <em>/ month</em></span>
            <a href="/products/routify" class="app-link">Learn more →</a>
          </div>
        </div>

        <div class="app">
          <div class="app-top">
            <div class="app-ico"><img src="/assets/payshift/payshift-avatar.png" alt="PayShift" width="52" height="52" /></div>
            <span class="tag tag-live">Live</span>
          </div>
          <h3>PayShift</h3>
          <p>Hide, reorder, and rename payment &amp; shipping methods at checkout, with rules that match how your store actually sells.</p>
          <div class="app-foot">
            <span class="app-price">Free <em>· Pro $3.99 / month</em></span>
            <a href="/products/payshift" class="app-link">Learn more →</a>
          </div>
        </div>

        <div class="app">
          <div class="app-top">
            <div class="app-ico"><img src="https://cdn.shopify.com/app-store/listing_images/dceae45ce42d4e6822a099d84a3d5eb1/icon/CKn41N-E-5UDEAE=.png" alt="GateKeeper" width="52" height="52" loading="lazy" /></div>
            <span class="tag tag-live">Live</span>
          </div>
          <h3>GateKeeper</h3>
          <p>Lock products, collections, pages or your whole store, hide prices until login, and choose exactly who gets in: customer tags, emails, passcodes or secret links.</p>
          <div class="app-foot">
            <span class="app-price">$0.00 <em>/ month</em></span>
            <a href="/products/gatekeeper" class="app-link">Learn more →</a>
          </div>
        </div>

        <div class="app">
          <div class="app-top">
            <div class="app-ico"><img src="https://cdn.shopify.com/app-store/listing_images/bf644a28103312af9fdee59bc1167edd/icon/CLLC4OGH5JYDEAE=.png" alt="ChargeIt" width="52" height="52" loading="lazy" /></div>
            <span class="tag tag-live">Live</span>
          </div>
          <h3>ChargeIt</h3>
          <p>Charge a fee for cash on delivery or reward prepaid orders with a discount, based on the payment method your customer picks.</p>
          <div class="app-foot">
            <span class="app-price">$0.00 <em>/ month</em></span>
            <a href="/products/chargeit" class="app-link">Learn more →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block approach">
    <div class="wrap">
      <h2>We're small on purpose.</h2>
      <p class="lead">A big app company treats you like a ticket number. We treat every merchant like the reason the app exists, because you are.</p>
      <div class="approach-grid">
        <div class="ap-item">
          <div class="ap-num">01</div>
          <h3>One job, done properly</h3>
          <p>Each app solves a single problem completely, instead of burying it under features you'll never touch.</p>
        </div>
        <div class="ap-item">
          <div class="ap-num">02</div>
          <h3>You reach the makers</h3>
          <p>Message us and you talk to the people who wrote the code, usually within minutes. We'll even set things up for you.</p>
        </div>
        <div class="ap-item">
          <div class="ap-num">03</div>
          <h3>Your ideas ship</h3>
          <p>Some of our best features started as a merchant email. You ask, we build, often in days, not quarters.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta" id="contact">
    <div class="wrap">
      <h2>Got an idea, a question, or a bug?</h2>
      <p>We genuinely want to hear it. Email us and you'll reach a real person, usually the same day.</p>
      <a href="mailto:cognitiolab1@gmail.com" class="btn btn-primary">Email the team</a>
    </div>
  </section>
</Base>
