---
import Base from '../layouts/Base.astro';

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "CognitioLab",
  "url": "https://cognitiolab.com",
  "description": "A studio building focused Shopify apps that solve real merchant problems.",
  "sameAs": ["https://x.com/cognitiolab", "https://www.linkedin.com/company/cognitiolabs"],
};
---
<Base navCta={{ label: 'Browse apps', href: '#apps' }}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(orgSchema)} />

  <header class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <span class="hero-dot d1" aria-hidden="true"></span>
    <span class="hero-dot d2" aria-hidden="true"></span>
    <span class="hero-dot d3" aria-hidden="true"></span>
    <div class="wrap">
      <div class="hero-eyebrow"><span class="live-dot"></span> A Shopify app studio · 2 apps live</div>
      <h1>Practical Shopify apps, built right.</h1>
      <p class="hero-lead">We build small, focused apps that fix real problems at checkout and across your store — then answer the phone when you need us. No bloat. No filler features.</p>
      <p class="hero-rotate">Made for your <span class="rot-word" id="rotword">checkout</span></p>
      <div class="hero-cta">
        <a href="#apps" class="btn btn-primary">See our apps</a>
        <a href="/blog" class="text-link">Read the blog →</a>
      </div>
    </div>
  </header>

  <div class="proof">
    <div class="wrap proof-inner">
      <div class="proof-quote">
        <div class="stars">★★★★★</div>
        <div>
          <div class="q">"Life saver."</div>
          <div class="who">SH Collection · Pakistan · Shopify App Store</div>
        </div>
      </div>
      <div class="proof-facts">
        <div class="proof-fact"><strong>2</strong><span>apps live, more coming</span></div>
        <div class="proof-fact"><strong>Free</strong><span>to install &amp; try</span></div>
        <div class="proof-fact"><strong>Minutes</strong><span>typical support reply</span></div>
      </div>
    </div>
  </div>

  <section class="block" id="apps">
    <div class="wrap">
      <div class="head-row">
        <div>
          <h2>Our apps</h2>
          <p>Live on the Shopify App Store — free to install.</p>
        </div>
      </div>

      <div class="apps-live">
        <div class="app">
          <div class="app-top">
            <div class="app-ico"><img src="/assets/routify/routify-logo.png" alt="Routify" width="52" height="52" /></div>
            <span class="tag tag-live">Live</span>
          </div>
          <h3>Routify</h3>
          <p>Manage 301 &amp; 404 redirects so you never lose SEO value — or leave a customer stranded on a dead page.</p>
          <div class="app-foot">
            <span class="app-price">$0.00 <em>/ month</em></span>
            <a href="/products/routify" class="app-link">Learn more →</a>
          </div>
        </div>

        <div class="app">
          <div class="app-top">
            <div class="app-ico"><img src="/assets/payshift/payshift-avatar.png" alt="PayShift" width="52" height="52" /></div>
            <span class="tag tag-live">Live</span>
          </div>
          <h3>PayShift</h3>
          <p>Hide, reorder, and rename payment &amp; shipping methods at checkout, with rules that match how your store actually sells.</p>
          <div class="app-foot">
            <span class="app-price">$0.00 <em>/ month</em></span>
            <a href="/products/payshift" class="app-link">Learn more →</a>
          </div>
        </div>
      </div>

      <div class="apps-soon">
        <div class="app-soon">
          <div class="app-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
          </div>
          <div>
            <h3>GateKeeper <span class="tag tag-soon">Coming soon</span></h3>
            <p>Lock and hide products, prices, collections, and pages — control exactly who sees what.</p>
          </div>
        </div>
        <div class="app-soon">
          <div class="app-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l14-5v12L3 13z"/><path d="M17 8a3 3 0 0 1 0 6"/><path d="M6 13v4a2 2 0 0 0 4 0"/></svg>
          </div>
          <div>
            <h3>TopBar Announce <span class="tag tag-soon">Coming soon</span></h3>
            <p>Rule-based announcement bars and countdown timers, targeted to the right shopper.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block approach">
    <div class="wrap">
      <h2>We're small on purpose.</h2>
      <p class="lead">A big app company treats you like a ticket number. We treat every merchant like the reason the app exists — because you are.</p>
      <div class="approach-grid">
        <div class="ap-item">
          <div class="ap-num">01</div>
          <h3>One job, done properly</h3>
          <p>Each app solves a single problem completely, instead of burying it under features you'll never touch.</p>
        </div>
        <div class="ap-item">
          <div class="ap-num">02</div>
          <h3>You reach the makers</h3>
          <p>Message us and you talk to the people who wrote the code — usually within minutes. We'll even set things up for you.</p>
        </div>
        <div class="ap-item">
          <div class="ap-num">03</div>
          <h3>Your ideas ship</h3>
          <p>Some of our best features started as a merchant email. You ask, we build — often in days, not quarters.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta" id="contact">
    <div class="wrap">
      <h2>Got an idea, a question, or a bug?</h2>
      <p>We genuinely want to hear it. Email us and you'll reach a real person — usually the same day.</p>
      <a href="mailto:cognitiolab1@gmail.com" class="btn btn-primary">Email the team</a>
    </div>
  </section>

  <script is:inline>
    (function () {
      const words = ['checkout', 'redirects', 'SEO', 'payments', 'conversions'];
      const el = document.getElementById('rotword');
      if (!el || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      let i = 0;
      setInterval(function () {
        i = (i + 1) % words.length;
        el.style.opacity = '0';
        el.style.transform = 'translateY(-4px)';
        setTimeout(function () {
          el.textContent = words[i];
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
        }, 250);
      }, 2200);
    })();
  </script>
</Base>
