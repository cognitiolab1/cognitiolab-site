---
// Shopify-style media gallery: main viewer (video first if provided, then screenshots) + thumbnail strip.
// Props: video (optional) = { id, title }; images = [{ src, alt }]
const { video = null, images = [] } = Astro.props;
const ytThumb = (id) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---
<div class="media-gallery" data-gallery>
  <div class="media-stage">
    {video && (
      <div class="media-item media-video is-active" data-item="0" data-video-id={video.id} data-video-title={video.title}>
        <button
          class="video-facade"
          data-open-lightbox
          style={`background-image:url(${ytThumb(video.id)})`}
          aria-label={`Play video: ${video.title}`}
        >
          <span class="play-btn" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
        </button>
      </div>
    )}
    {images.map((img, i) => (
      <div class={`media-item${!video && i === 0 ? ' is-active' : ''}`} data-item={video ? i + 1 : i}>
        <img src={img.src} alt={img.alt} loading="lazy" width="1600" height="900" data-open-lightbox />
      </div>
    ))}
    <button class="media-arrow prev" data-prev aria-label="Previous">&#8249;</button>
    <button class="media-arrow next" data-next aria-label="Next">&#8250;</button>
  </div>

  <div class="media-thumbs" data-thumbs>
    {video && (
      <button class="thumb thumb-video is-active" data-thumb="0" aria-label="Video">
        <img src={ytThumb(video.id)} alt="" loading="lazy" />
        <span class="thumb-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </span>
      </button>
    )}
    {images.map((img, i) => (
      <button class={`thumb${!video && i === 0 ? ' is-active' : ''}`} data-thumb={video ? i + 1 : i} aria-label={`Screenshot ${i + 1}`}>
        <img src={img.src} alt="" loading="lazy" />
      </button>
    ))}
  </div>

  <div class="lightbox" data-lightbox>
    <button class="lightbox-close" data-lb-close aria-label="Close">&times;</button>
    <button class="lightbox-arrow prev" data-lb-prev aria-label="Previous">&#8249;</button>
    <button class="lightbox-arrow next" data-lb-next aria-label="Next">&#8250;</button>
    <div class="lightbox-content" data-lb-content></div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-gallery]').forEach((g) => {
    const items = Array.from(g.querySelectorAll('[data-item]'));
    const thumbs = Array.from(g.querySelectorAll('[data-thumb]'));
    const thumbsWrap = g.querySelector('[data-thumbs]');
    const prevBtn = g.querySelector('[data-prev]');
    const nextBtn = g.querySelector('[data-next]');
    const videoItem = g.querySelector('.media-video');
    let idx = 0;

    function show(i) {
      idx = (i + items.length) % items.length;
      items.forEach((it, j) => it.classList.toggle('is-active', j === idx));
      thumbs.forEach((t, j) => t.classList.toggle('is-active', j === idx));
      const t = thumbs[idx];
      if (t && thumbsWrap) {
        thumbsWrap.scrollTo({ left: t.offsetLeft - thumbsWrap.clientWidth / 2 + t.clientWidth / 2, behavior: 'smooth' });
      }
    }

    prevBtn && prevBtn.addEventListener('click', () => show(idx - 1));
    nextBtn && nextBtn.addEventListener('click', () => show(idx + 1));
    thumbs.forEach((t, j) => t.addEventListener('click', () => show(j)));

    // Lightbox: opens screenshots at full size, and plays the video large.
    const lb = g.querySelector('[data-lightbox]');
    const lbContent = g.querySelector('[data-lb-content]');
    const lbClose = g.querySelector('[data-lb-close]');
    const lbPrev = g.querySelector('[data-lb-prev]');
    const lbNext = g.querySelector('[data-lb-next]');
    let lbIdx = 0;

    function renderLightbox(i) {
      lbIdx = (i + items.length) % items.length;
      const item = items[lbIdx];
      lbContent.innerHTML = '';
      if (item === videoItem) {
        const id = videoItem.getAttribute('data-video-id');
        const title = videoItem.getAttribute('data-video-title') || 'Video';
        const wrap = document.createElement('div');
        wrap.className = 'lb-video';
        const iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
        iframe.title = title;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.setAttribute('allowfullscreen', '');
        wrap.appendChild(iframe);
        lbContent.appendChild(wrap);
      } else {
        const src = item.querySelector('img').getAttribute('src');
        const alt = item.querySelector('img').getAttribute('alt') || '';
        const img = document.createElement('img');
        img.src = src;
        img.alt = alt;
        lbContent.appendChild(img);
      }
    }

    function openLightbox(i) {
      renderLightbox(i);
      lb.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lb.classList.remove('is-open');
      lbContent.innerHTML = '';
      document.body.style.overflow = '';
    }

    g.querySelectorAll('[data-open-lightbox]').forEach((el) => {
      el.addEventListener('click', () => openLightbox(idx));
    });

    lbClose.addEventListener('click', closeLightbox);
    lb.addEventListener('click', (e) => { if (e.target === lb) closeLightbox(); });
    lbPrev.addEventListener('click', () => renderLightbox(lbIdx - 1));
    lbNext.addEventListener('click', () => renderLightbox(lbIdx + 1));
    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') renderLightbox(lbIdx - 1);
      if (e.key === 'ArrowRight') renderLightbox(lbIdx + 1);
    });
  });
</script>
