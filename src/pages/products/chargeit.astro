---
import Base from '../../layouts/Base.astro';
import MediaGallery from '../../components/MediaGallery.astro';

const appUrl = 'https://apps.shopify.com/chargeit';
const title = 'ChargeIt: COD fees & prepaid discounts for Shopify | CognitioLab';
const description = 'ChargeIt adds a fee or a discount on Shopify based on the payment method the customer picks: charge for cash on delivery, reward prepaid orders. Free to install.';

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "ChargeIt",
  "alternateName": "ChargeIt: Payment Method Fees",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Shopify",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "description": "Add a fee or a discount on Shopify based on the payment method the customer chooses.",
  "url": appUrl,
};

const video = { id: '54n6DC3Sz7I', title: 'ChargeIt overview' };

const images = [
  { src: 'https://cdn.shopify.com/app-store/listing_images/bf644a28103312af9fdee59bc1167edd/desktop_screenshot/CKONhtya7JYDEAE=.png', alt: 'Cart page widget where the shopper picks a payment method' },
  { src: 'https://cdn.shopify.com/app-store/listing_images/bf644a28103312af9fdee59bc1167edd/desktop_screenshot/COSAj9ya7JYDEAE=.png', alt: 'Cash on delivery selected, adding a named handling fee line' },
  { src: 'https://cdn.shopify.com/app-store/listing_images/bf644a28103312af9fdee59bc1167edd/desktop_screenshot/CNnsmNya7JYDEAE=.png', alt: 'Prepaid method selected, applying a named order discount' },
  { src: 'https://cdn.shopify.com/app-store/listing_images/bf644a28103312af9fdee59bc1167edd/desktop_screenshot/CMPgotya7JYDEAE=.png', alt: 'Six starter rule templates in the ChargeIt admin' },
  { src: 'https://cdn.shopify.com/app-store/listing_images/bf644a28103312af9fdee59bc1167edd/desktop_screenshot/CIe6q9ya7JYDEAE=.png', alt: 'Cart widget in six theme colour presets' },
  { src: 'https://cdn.shopify.com/app-store/listing_images/bf644a28103312af9fdee59bc1167edd/desktop_screenshot/CLOgtNya7JYDEAE=.png', alt: 'Storefront announcement bar with a countdown timer' },
];

const faqs = [
  { q: 'Can I charge extra for cash on delivery?', a: 'Yes. Create a rule for your cash on delivery method and set a fixed amount (for example 3) or a percentage. ChargeIt adds it to the order as a line you name, such as "COD handling fee".' },
  { q: 'Can I give a discount for paying upfront?', a: 'Yes. Set a discount on your card or other prepaid methods to nudge customers away from cash on delivery.' },
  { q: 'Where does the customer choose how to pay?', a: 'On the cart page, using a payment method selector styled to your theme. The fee or discount appears there, before checkout, so there are no surprises.' },
  { q: 'Can a customer pick a prepaid method for the discount and then switch to cash on delivery?', a: 'No. Checkout only offers the payment method the customer chose in the cart.' },
  { q: 'Is the fee added to the shipping price?', a: 'No. It appears as its own named line on the order, separate from shipping.' },
  { q: 'Can I limit a rule to some orders only?', a: 'Yes. Narrow any rule by country, cart value, customer type, customer tags or products, and tier the amount by cart subtotal.' },
  { q: 'Is ChargeIt free?', a: 'Yes, ChargeIt is free to install and use.' },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
};

const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
---
<Base title={title} description={description} navCta={{ label: 'Install free', href: appUrl }}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <header class="prod-hero">
    <div class="wrap prod-hero-grid">
      <div>
        <a href="/#apps" class="back-link">← All apps</a>
        <div class="app-ico"><img src="https://cdn.shopify.com/app-store/listing_images/bf644a28103312af9fdee59bc1167edd/icon/CLLC4OGH5JYDEAE=.png" alt="ChargeIt" width="62" height="62" /></div>
        <div class="prod-badge"><span class="tag tag-live">Live on the App Store · Free</span></div>
        <h1>Price cash on delivery and prepaid orders differently.</h1>
        <p class="lead">Cash on delivery costs more to fulfil than a prepaid order, but most stores charge the same for both. ChargeIt adds a fee or a discount based on the payment method your customer picks.</p>
        <div class="hero-cta">
          <a href={appUrl} class="btn btn-primary">Install free</a>
          <a href="mailto:cognitiolab1@gmail.com" class="text-link">Questions? Email us →</a>
        </div>
      </div>
      <MediaGallery video={video} images={images} />
    </div>
  </header>

  <section class="feat-list">
    <div class="wrap">
      <div class="head-row"><div><h2>What ChargeIt does</h2><p>Fees and discounts tied to how your customer pays.</p></div></div>
      <div class="feat-grid">
        <div class="feat">
          <div class="feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/></svg></div>
          <div><h3>Cash on delivery fees</h3><p>Add a fixed amount or a percentage when the customer chooses cash on delivery, on a line you name.</p></div>
        </div>
        <div class="feat">
          <div class="feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><path d="M7.5 7.5h.01"/></svg></div>
          <div><h3>Prepaid discounts</h3><p>Reward card and other prepaid payments with a discount, so fewer orders come in as cash on delivery.</p></div>
        </div>
        <div class="feat">
          <div class="feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg></div>
          <div><h3>Flat or tiered amounts</h3><p>Charge the same on every order, or tier the fee or discount by cart subtotal.</p></div>
        </div>
        <div class="feat">
          <div class="feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 3H2l8 9.5V19l4 2v-8.5z"/></svg></div>
          <div><h3>Rules that fit your store</h3><p>Limit a rule by country, cart value, customer type, customer tags or products.</p></div>
        </div>
        <div class="feat">
          <div class="feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg></div>
          <div><h3>Payment choice in the cart</h3><p>A payment method selector on the cart page, styled to your theme with six colour presets.</p></div>
        </div>
        <div class="feat">
          <div class="feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l14-5v12L3 13z"/><path d="M17 8a3 3 0 0 1 0 6"/></svg></div>
          <div><h3>Announce your offer</h3><p>Tell shoppers about a prepaid discount with an announcement bar, with an optional countdown.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="steps">
    <div class="wrap">
      <div class="head-row"><div><h2>Live in three steps</h2><p>Your first fee or discount in minutes.</p></div></div>
      <div class="steps-grid">
        <div class="step">
          <div class="step-num">1</div>
          <h3>Install ChargeIt</h3>
          <p>Add ChargeIt to your store for free and turn on the payment method selector for your cart page.</p>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <h3>Create a rule</h3>
          <p>Start from one of six templates or a blank rule. Choose the payment method, the fee or discount, and any conditions.</p>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <h3>Customers choose, ChargeIt applies</h3>
          <p>Shoppers pick how they will pay in the cart, and the fee or discount appears there, before checkout.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="usecases">
    <div class="wrap">
      <div class="head-row"><div><h2>Who ChargeIt is for</h2><p>Stores where the payment method changes the cost of an order.</p></div></div>
      <div class="uc-grid">
        <div class="uc">
          <h3><span class="uc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></span>Cash on delivery stores</h3>
          <p>Cover courier collection charges and returned orders with a cash on delivery fee.</p>
        </div>
        <div class="uc">
          <h3><span class="uc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>Stores pushing prepaid</h3>
          <p>Move more customers to card payments with a prepaid discount, and cut the risk of unpaid deliveries.</p>
        </div>
        <div class="uc">
          <h3><span class="uc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18"/><path d="M12 3a14 14 0 0 0 0 18"/></svg></span>Selling in several countries</h3>
          <p>Charge for cash on delivery only in the countries where you offer it, and leave everyone else untouched.</p>
        </div>
        <div class="uc">
          <h3><span class="uc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg></span>High-value orders</h3>
          <p>Tier the fee by cart subtotal, so larger orders carry a fee that matches their risk.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="pricing" id="pricing">
    <div class="wrap">
      <div class="head-row"><div><h2>Pricing</h2><p>Free to install and use.</p></div></div>
      <div class="price-card">
        <div class="amount">$0.00 <em>/ month</em></div>
        <div class="price-note">Free to install, free to use</div>
        <ul class="price-list">
          <li><Fragment set:html={check} /> Fees and discounts by payment method</li>
          <li><Fragment set:html={check} /> Fixed or percentage, flat or tiered by subtotal</li>
          <li><Fragment set:html={check} /> Cart payment selector, six templates, announcement bar</li>
          <li><Fragment set:html={check} /> Real human support, no queue</li>
        </ul>
        <a href={appUrl} class="btn btn-primary">Install free</a>
      </div>
    </div>
  </section>

  <section class="faq">
    <div class="wrap">
      <div class="head-row"><div><h2>Frequently asked questions</h2><p>Everything you need to know before you install.</p></div></div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Stop charging the same for every payment method.</h2>
      <p>ChargeIt is free to install. Set up your first fee or discount today.</p>
      <a href={appUrl} class="btn btn-primary">Get ChargeIt free</a>
    </div>
  </section>
</Base>
