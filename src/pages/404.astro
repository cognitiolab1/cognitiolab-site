---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | CognitioLab" description="This page doesn't exist. Browse CognitioLab's Shopify apps or read the blog.">
  <meta name="robots" content="noindex" slot="head" />

  <section class="cta">
    <div class="wrap">
      <h1>Page not found</h1>
      <p>This page doesn't exist or has moved. Try our apps or the blog instead.</p>
      <a href="/#apps" class="btn btn-primary">See our apps</a>
      <p><a href="/blog" class="text-link">Read the blog →</a></p>
    </div>
  </section>
</Base>
