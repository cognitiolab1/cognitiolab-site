---
// Reusable screenshot slider. Props: slides = [{ src, alt }]
const { slides = [] } = Astro.props;
---
<div class="slider" data-slider>
  <div class="slider-viewport">
    <div class="slider-track" data-track>
      {slides.map((s) => (
        <div class="slide">
          <div class="shot"><img src={s.src} alt={s.alt} width="1600" height="900" loading="lazy" /></div>
        </div>
      ))}
    </div>
    <button class="slider-arrow prev" data-prev aria-label="Previous screenshot">&#8249;</button>
    <button class="slider-arrow next" data-next aria-label="Next screenshot">&#8250;</button>
  </div>
  <div class="slider-dots" data-dots>
    {slides.map((_, i) => (
      <button class="dot" data-dot={i} aria-label={`Go to screenshot ${i + 1}`}></button>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll('[data-slider]').forEach((root) => {
    const track = root.querySelector('[data-track]');
    const slides = Array.from(track.children);
    const dots = Array.from(root.querySelectorAll('[data-dot]'));
    const prevBtn = root.querySelector('[data-prev]');
    const nextBtn = root.querySelector('[data-next]');
    let idx = 0;

    const setActive = (i) => {
      idx = Math.max(0, Math.min(slides.length - 1, i));
      dots.forEach((d, j) => d.classList.toggle('active', j === idx));
    };
    const goTo = (i) => {
      const t = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: slides[t].offsetLeft, behavior: 'smooth' });
    };

    prevBtn && prevBtn.addEventListener('click', () => goTo(idx - 1));
    nextBtn && nextBtn.addEventListener('click', () => goTo(idx + 1));
    dots.forEach((d, j) => d.addEventListener('click', () => goTo(j)));

    let timer;
    track.addEventListener('scroll', () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        let best = 0, bestDist = Infinity;
        slides.forEach((s, j) => {
          const dist = Math.abs(s.offsetLeft - track.scrollLeft);
          if (dist < bestDist) { bestDist = dist; best = j; }
        });
        setActive(best);
      }, 80);
    });

    setActive(0);
  });
</script>
